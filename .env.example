# Postgres connection string.
# In Railway, use the PRIVATE internal URL (auto-injected as DATABASE_URL) so the
# UI reaches the DB over the private network with no egress fees.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# HTTP port (Railway sets PORT automatically).
PORT=3000

# HTTP Basic Auth. One or more "user:password" pairs, comma-separated.
# The authenticated username is recorded as the `actor` in the brand audit log.
AUTH_USERS=alice:secret,bob:hunter2

# (Legacy) Used only when AUTH_USERS is empty.
# Leave everything empty to disable auth (e.g. local dev).
AUTH_USER=
AUTH_PASS=
