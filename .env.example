# Postgres connection string.
# In Railway, use the PRIVATE internal URL (auto-injected as DATABASE_URL) so the
# UI reaches the DB over the private network with no egress fees.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# HTTP port (Railway sets PORT automatically).
PORT=3000

# HTTP Basic Auth. Set BOTH to require a username/password to access the UI.
# Leave empty to disable auth (e.g. local dev).
AUTH_USER=
AUTH_PASS=
